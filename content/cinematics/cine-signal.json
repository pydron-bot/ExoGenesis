    {
      "at": 5,
      "character": "archivist",
      "text": "Hiss. The sun. Our own report, going up to the moon.",
      "for": 4.5
    },
    {
      "at": 10.5,
      "character": "archivist",
      "text": "Wait. There's something under it. Narrowband, very weak. Not ours. Not from here.",
      "for": 5
