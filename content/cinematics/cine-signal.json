    {
      "at": 17,
      "character": "marrow",
      "text": "…this is Captain Ilse Marrow of the Kindred.",
      "for": 4.2
    },
    {
      "at": 21.8,
      "character": "marrow",
      "text": "If there is a human being listening on this band, answer.",
      "for": 4.5
    },
    {
      "at": 27,
      "character": "marrow",
      "text": "If you are a machine, keep quiet.",
      "for": 3.8
