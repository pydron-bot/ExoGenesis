    {
      "at": 4,
      "speaker": "Kindred sentry",
      "text": "Captain. It's on the ramp. It's just… walking.",
      "for": 4
    },
    {
      "at": 9,
      "character": "marrow",
      "text": "Let it walk. Hands off the triggers. All of you.",
      "for": 4.5
    },
    {
      "at": 15,
      "character": "marrow",
      "text": "All those years in a can to get here, and the first visitor is a machine. Of course it is.",
      "for": 6
    },
    {
      "at": 22.5,
      "character": "bede",
      "text": "It's slowed down for the children, Captain. Look. It's letting them get out of the way.",
      "for": 5.5
    },
    {
      "at": 29,
      "character": "marrow",
      "text": "I saw.",
      "for": 2.5
    },
    {
      "at": 33,
      "character": "marrow",
      "text": "Open the hall. If it wants to talk, we'll talk. Femi, sit by the door.",
      "for": 5
    },
    {
      "at": 39.5,
      "character": "bede",
      "text": "I always do.",
      "for": 3
    },
    {
      "at": 44,
      "character": "marrow",
      "text": "Well? Come in, then.",
      "for": 4
    }
  ],
