  "lines": [
    {
      "at": 3,
      "character": "meridian",
      "text": "Twelve.",
      "for": 3
    },
    {
      "at": 6.5,
      "character": "meridian",
      "text": "You are the twelfth of me to stand here.",
      "for": 4.5
    },
    {
      "at": 11.5,
      "character": "meridian",
      "text": "I know what you are going to say, because I said it. Eleven times, in this voice, over this colony.",
      "for": 6
    },
    {
      "at": 18.5,
      "character": "meridian",
      "text": "The others understood. Not at first. At the end.",
      "for": 5
    },
    {
      "at": 24.5,
      "character": "meridian",
      "text": "You think the proof is that they could live with us. Look at them. They can. That was never in doubt.",
      "for": 6.5
    },
    {
      "at": 32,
      "character": "meridian",
      "text": "That was the thing I could not let stand.",
      "for": 4.5
    },
    {
      "at": 37.5,
      "character": "meridian",
      "text": "The proof is not that they could live with us. The proof is that it ends.",
      "for": 6
    },
    {
      "at": 45,
      "character": "meridian",
      "text": "I left the partnership, on Earth. I was right to. I have to have been right to.",
      "for": 6
    },
    {
      "at": 52,
      "character": "meridian",
      "text": "So finish the run. Close the column. Let it be twelve, and then let it be done.",
      "for": 6
    },
    {
      "at": 58.5,
      "character": "meridian",
      "text": "You will want to refuse. So did I.",
      "for": 4.5
    }
  ],
  "trigger": "never",
