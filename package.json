{
  "name": "exogenesis",
  "version": "0.43.0",
  "private": true,
  "description": "Exo Genesis: browser base-building RTS with a strategy layer, in one solar system.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "node tools/content-check.mjs && node tools/version-check.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "shot": "node tools/shot.mjs",
    "content:check": "node tools/content-check.mjs",
    "version:check": "node tools/version-check.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
